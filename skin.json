{
  "name": "TGUI",
  "version": "3.0.4",
  "author": ["[https://github.com/AyIong Aylong]"],
  "url": "https://www.youtube.com/watch?v=JDQBvN1GATw",
  "namemsg": "skinname-tgui",
  "descriptionmsg": "tgui-skin-desc",
  "license-name": "GPL-2.0-or-later",
  "type": "skin",
  "requires": {
    "MediaWiki": ">= 1.43.0"
  },
  "attributes": {
    "DarkMode": {
      "Disabled": ["tgui"]
    }
  },
  "ValidSkinNames": {
    "tgui": {
      "class": "MediaWiki\\Skins\\TGUI\\SkinTGUI",
      "args": [
        {
          "name": "tgui",
          "responsive": true,
          "wrapSiteNotice": true,
          "toc": false,
          "link": {
            "text-wrapper": {
              "tag": "span"
            }
          },
          "menus": [
            "user-interface-preferences",
            "user-menu",
            "notifications",
            "views",
            "actions",
            "variants",
            "associated-pages"
          ],
          "scripts": ["skins.tgui.scripts"],
          "styles": ["skins.tgui.styles", "skins.tgui.icons"],
          "messages": [
            "search",
            "searchbutton",
            "searcharticle",
            "searchsuggest-search",
            "sitetitle",
            "tagline",
            "personaltools",
            "tgui-toc-heading",
            "tgui-usermenu",
            "tgui-actions-more-toggle",
            "tgui-preferences"
          ]
        }
      ]
    }
  },
  "SkinLessImportPaths": {
    "tgui": "resources/mediawiki.less"
  },
  "MessagesDirs": {
    "TGUI": ["i18n"]
  },
  "AutoloadNamespaces": {
    "MediaWiki\\Skins\\TGUI\\": "includes/"
  },
  "HookHandlers": {
    "SkinHooks": {
      "class": "MediaWiki\\Skins\\TGUI\\Hooks\\SkinHooks"
    }
  },
  "Hooks": {
    "BeforePageDisplay": "SkinHooks",
    "SkinBuildSidebar": "SkinHooks",
    "SkinPageReadyConfig": "SkinHooks"
  },
  "ResourceModules": {
    "skins.tgui.styles": {
      "class": "MediaWiki\\ResourceLoader\\SkinModule",
      "features": {
        "normalize": true,
        "interface-edit-section-links": true,
        "interface-user-message": true,
        "i18n-ordered-lists": true,
        "i18n-headings": true,
        "toc": false
      },
      "styles": ["resources/skins.tgui.styles/core-skin.less"]
    },
    "skins.tgui.scripts": {
      "packageFiles": [
        "resources/skins.tgui.scripts/skin.js",
        {
          "name": "resources/skins.tgui.scripts/config.json",
          "callback": "MediaWiki\\Skins\\TGUI\\Hooks\\ResourceLoaderHooks::getTGUIResourceLoaderConfig"
        },
        "resources/skins.tgui.scripts/clipboardCopy.js",
        "resources/skins.tgui.scripts/deferUntilFrame.js",
        "resources/skins.tgui.scripts/dropdown.js",
        "resources/skins.tgui.scripts/floatingDropdown.js",
        "resources/skins.tgui.scripts/floatingPopups.js",
        "resources/skins.tgui.scripts/floatingTitles.js",
        "resources/skins.tgui.scripts/floatingTooltips.js",
        "resources/skins.tgui.scripts/purgeButton.js",
        "resources/skins.tgui.scripts/resizeObserver.js",
        "resources/skins.tgui.scripts/scrollObserver.js",
        "resources/skins.tgui.scripts/searchLoader.js",
        "resources/skins.tgui.scripts/sectionObserver.js",
        "resources/skins.tgui.scripts/sections.js",
        "resources/skins.tgui.scripts/setupObservers.js",
        "resources/skins.tgui.scripts/tableOfContents.js",
        "resources/skins.tgui.scripts/tables.js",
        {
          "name": "resources/skins.tgui.scripts/tableOfContentsConfig.json",
          "config": ["TGUITableOfContentsCollapseAtCount"]
        },
        {
          "name": "resources/skins.tgui.scripts/templates/TableOfContents.mustache",
          "file": "templates/TableOfContents.mustache",
          "type": "text"
        },
        {
          "name": "resources/skins.tgui.scripts/templates/TableOfContents__list.mustache",
          "file": "templates/TableOfContents__list.mustache",
          "type": "text"
        },
        {
          "name": "resources/skins.tgui.scripts/templates/TableOfContents__line.mustache",
          "file": "templates/TableOfContents__line.mustache",
          "type": "text"
        }
      ],
      "messages": [
        "tgui-search-loader",
        "tgui-purge-button-label",
        "tgui-purge-button-title",
        "tgui-clipboard-tooltip",
        "tgui-clipboard-success",
        "tgui-clipboard-failure"
      ],
      "dependencies": ["mediawiki.page.ready", "mediawiki.util"]
    },
    "skins.tgui.search.codex.styles": {
      "class": "MediaWiki\\ResourceLoader\\CodexModule",
      "codexStyleOnly": false,
      "codexComponents": ["CdxTypeaheadSearch", "CdxSearchInput", "CdxButton", "CdxRadio", "CdxMessage"]
    },
    "skins.tgui.search.codex.scripts": {
      "dependencies": ["skins.tgui.search.codex.styles"],
      "class": "MediaWiki\\ResourceLoader\\CodexModule",
      "codexScriptOnly": true,
      "codexComponents": ["CdxTypeaheadSearch"]
    },
    "skins.tgui.search": {
      "es6": true,
      "packageFiles": [
        "resources/skins.tgui.search/skins.tgui.search.js",
        "resources/skins.tgui.search/instrumentation.js",
        "resources/skins.tgui.search/fetch.js",
        "resources/skins.tgui.search/restSearchClient.js",
        "resources/skins.tgui.search/urlGenerator.js",
        "resources/skins.tgui.search/App.vue",
        {
          "name": "resources/skins.tgui.search/config.json",
          "callback": "MediaWiki\\Skins\\TGUI\\Hooks\\SkinHooks::getTGUISearchResourceLoaderConfig"
        }
      ],
      "dependencies": ["web2017-polyfills", "mediawiki.util", "skins.tgui.search.codex.scripts"],
      "messages": ["searchbutton", "searchresults", "tgui-searchsuggest-containing"]
    },
    "skins.tgui.preferences": {
      "styles": ["resources/skins.tgui.preferences/skins.tgui.preferences.less"],
      "packageFiles": [
        "resources/skins.tgui.preferences/skins.tgui.preferences.js",
        {
          "name": "resources/skins.tgui.preferences/config.json",
          "callback": "MediaWiki\\Skins\\TGUI\\Hooks\\ResourceLoaderHooks::getTGUIPreferencesResourceLoaderConfig"
        },
        "resources/skins.tgui.preferences/addPortlet.polyfill.js",
        "resources/skins.tgui.preferences/clientPreferences.js",
        "resources/skins.tgui.preferences/clientPreferences.json",
        "resources/skins.tgui.preferences/clientPrefs.polyfill.js"
      ],
      "messages": [
        "preferences",
        "tgui-preferences-appearance-tab-name",
        "tgui-preferences-accessibility-tab-name",
        "tgui-reset-button",
        "tgui-theme-name",
        "tgui-theme-description",
        "tgui-theme-day-label",
        "tgui-theme-night-label",
        "tgui-theme-os-label",
        "tgui-theme-style-name",
        "tgui-theme-style-default-label",
        "tgui-theme-style-ntos-label",
        "tgui-theme-style-paradise-label",
        "tgui-feature-blur-name",
        "tgui-feature-blur-enabled-label",
        "tgui-feature-blur-disabled-label",
        "tgui-feature-reduced-motion-name",
        "tgui-feature-reduced-motion-enabled-label",
        "tgui-feature-reduced-motion-disabled-label",
        "tgui-feature-holidays-name",
        "tgui-feature-holidays-enabled-label",
        "tgui-feature-holidays-disabled-label",
        "tgui-feature-darkened-images-name",
        "tgui-feature-darkened-images-disabled-label",
        "tgui-feature-darkened-images-light-label",
        "tgui-feature-darkened-images-medium-label",
        "tgui-feature-primary-hue-slider-name"
      ],
      "dependencies": ["mediawiki.storage", "mediawiki.util"]
    },
    "skins.tgui.serviceWorker": {
      "scripts": ["resources/skins.tgui.serviceWorker/sw.js"]
    },
    "skins.tgui.icons": {
      "selectorWithoutVariant": ".mw-ui-icon-wikimedia-{name}:before",
      "useDataURI": false,
      "defaultColor": "#000",
      "class": "MediaWiki\\ResourceLoader\\OOUIIconPackModule",
      "useMaskImage": true,
      "variants": {},
      "icons": [
        "article",
        "edit",
        "editLock",
        "history",
        "speechBubbles",
        "speechBubbleAdd",
        "wikiText",
        "language",
        "ellipsis",
        "userAvatar",
        "userAdd",
        "userAnonymous",
        "userTalk",
        "sandbox",
        "search",
        "settings",
        "labFlask",
        "watchlist",
        "userContributions",
        "logIn",
        "logOut",
        "imageGallery",
        "userGroup",
        "expand",
        "listBullet"
      ]
    }
  },
  "ResourceFileModulePaths": {
    "localBasePath": "",
    "remoteSkinPath": "TGUI"
  },
  "ResourceModuleSkinStyles": {
    "tgui": {
      "+ext.echo.styles.alert": "skinStyles/extensions/ext.echo.styles.alert.less",
      "+ext.relatedArticles.readMore": "skinStyles/extensions/ext.relatedArticles.readMore.less",
      "+ext.tabs": "skinStyles/extensions/ext.tabs.less",
      "+ext.uls.compactlinks": "skinStyles/extensions/ext.uls.compactlinks.less",
      "+ext.uls.interface": "skinStyles/extensions/ext.uls.interface.less",
      "+ext.wikiEditor": "skinStyles/extensions/ext.wikiEditor.less",
      "+ext.visualEditor": "skinStyles/extensions/ext.visualEditor.less",
      "+ext.visualEditor.base": "skinStyles/extensions/ext.visualEditor.less",
      "+ext.CodeMirror.lib": "skinStyles/extensions/ext.CodeMirror.lib.less",
      "+ext.codeEditor.ace": "skinStyles/extensions/CodeEditor/ext.codeEditor.ace.less",
      "+ext.tabberNeue.init.styles": "skinStyles/extensions/TabberNeue/ext.tabberNeue.init.styles.less",
      "+jquery.codeEditor": "skinStyles/extensions/CodeEditor/jquery.codeEditor.less",
      "+jquery.tablesorter.styles": "skinStyles/jQuery/jquery.tablesorter.styles.less",
      "+mediawiki.special.preferences.styles.ooui": "skinStyles/mediawiki/special/mediawiki.special.preferences.styles.ooui.less",
      "+mediawiki.special.search.styles": "skinStyles/mediawiki/special/mediawiki.special.search.styles.less",
      "+mediawiki.ui.button": "skinStyles/mediawiki/ui/mediawiki.ui.button.less",
      "+mediawiki.ui.icon": "skinStyles/mediawiki/ui/mediawiki.ui.icon.less",
      "+mediawiki.action.edit": "skinStyles/mediawiki/mediawiki.action.edit.less",
      "+mediawiki.action.view.filepage": "skinStyles/mediawiki/mediawiki.action.view.filepage.less",
      "+mediawiki.action.view.redirectPage": "skinStyles/mediawiki/mediawiki.action.view.redirectPage.less",
      "+mediawiki.notification": "skinStyles/mediawiki/mediawiki.notification.less",
      "+mediawiki.page.gallery.styles": "skinStyles/mediawiki/mediawiki.page.gallery.styles.less",
      "+mediawiki.pager.styles": "skinStyles/mediawiki/mediawiki.pager.styles.less",
      "+mediawiki.rcfilters.filters.ui": "skinStyles/mediawiki/mediawiki.rcfilters.filters.ui.less",
      "+mediawiki.codex.messagebox.styles": "skinStyles/codex/mediawiki.codex.messagebox.styles.less",
      "+oojs-ui-core.styles": "skinStyles/ooui/oojs-ui-core.less"
    }
  },
  "config_prefix": "wgTGUI",
  "config": {
    "EnablePreferences": {
      "value": true,
      "description": "Enables or disable preferences module",
      "descriptionmsg": "tgui-config-enablepreferences",
      "public": true
    },
    "ThemeDefault": {
      "value": "auto",
      "description": "Default theme of the skin. Valid values are 'light', 'dark' and 'auto'.",
      "descriptionmsg": "tgui-config-themedefault",
      "public": true
    },
    "ThemeStyleDefault": {
      "value": "default",
      "description": "Default theme style of the skin. Valid values are 'default', 'ntos' and 'paradise'.",
      "descriptionmsg": "tgui-config-themestyledefault",
      "public": true
    },
    "ThemeColor": {
      "value": "#191919",
      "description": "The theme color defined in the meta tag",
      "descriptionmsg": "tgui-config-themecolor",
      "public": true
    },
    "Tooltips": {
      "value": ["tooltiptext", "tooltiptext2", "tooltiptable"],
      "description": "Defines tooltip content css classes.",
      "descriptionmsg": "tgui-config-tooltips",
      "public": true
    },
    "Dropdowns": {
      "value": ["floating-dropdown--content"],
      "description": "Defines dropdown content css classes.",
      "descriptionmsg": "tgui-config-dropdowns",
      "public": true
    },
    "ReplaceTitleTooltips": {
      "value": true,
      "description": "Replaces buildin browser tooltips, with FloatingUI ones.",
      "descriptionmsg": "tgui-config-title-tooltips",
      "public": true
    },
    "EnableCollapsibleSections": {
      "value": true,
      "description": "Enables or disable collapsible sections on content pages",
      "descriptionmsg": "tgui-config-enablecollapsiblesections",
      "public": true
    },
    "EnableHolidays": {
      "value": true,
      "description": "Enables or disable holidays styles and scripts.",
      "descriptionmsg": "tgui-config-enableholidays",
      "public": true
    },
    "ShowPageTools": {
      "value": true,
      "description": "Page tools visibility condition",
      "descriptionmsg": "tgui-config-showpagetools",
      "public": true
    },
    "SearchApiUrl": {
      "value": "",
      "description": "To override the default search API, set this to the URL to rest.php on another wiki. Can be used with $wgDisableTextSearch and $wgSearchForwardUrl to mimic user experience on production."
    },
    "UseIconWatch": {
      "value": true
    },
    "WvuiSearchOptions": {
      "value": {
        "showThumbnail": true,
        "showDescription": true
      }
    },
    "TableOfContentsCollapseAtCount": {
      "value": 20,
      "description": "@var The minimum number of headings required to collapse all headings in the sticky table of contents by default."
    }
  },
  "manifest_version": 2
}
