{
  "name": "mediawiki/tgui-skin",
  "type": "mediawiki-skin",
  "description": "TGUI like skin for MediaWiki",
  "keywords": ["wiki", "MediaWiki", "skin"],
  "homepage": "https://github.com/AyIong/mediawiki-TGUI",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Aylong"
    }
  ],
  "support": {
    "source": "https://github.com/AyIong/mediawiki-TGUI"
  },
  "require": {
    "composer/installers": ">1.0.12"
  },
  "extra": {
    "installer-name": "TGUI"
  },
  "require-dev": {
    "mediawiki/mediawiki-codesniffer": "45.0.0",
    "mediawiki/mediawiki-phan-config": "0.14.0",
    "mediawiki/minus-x": "1.1.3",
    "php-parallel-lint/php-console-highlighter": "1.0.0",
    "php-parallel-lint/php-parallel-lint": "1.4.0"
  },
  "scripts": {
    "fix": ["minus-x fix .", "phpcbf"],
    "test": ["parallel-lint . --exclude node_modules --exclude vendor", "@phpcs", "minus-x check ."],
    "test:size": "phpunit -c ../../phpunit.xml.dist tests/phpunit/structure/BundleSizeTest.php --verbose",
    "phan": "phan -d . --long-progress-bar",
    "phpcs": "phpcs -sp --cache"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
