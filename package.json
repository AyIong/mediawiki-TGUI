{
  "name": "tgui",
  "private": true,
  "version": "3.2.5-mediawiki",
  "scripts": {
    "test:a11y": "node tests/a11y/runA11yTests.js",
    "selenium-daily": "node tests/a11y/runA11yTests.js --logResults",
    "lint": "biome check resources",
    "lint:fix": "prettier . --write && biome check . --fix",
    "lint:all": "biome check resources && banana-checker --requireLowerCase=0 i18n/",
    "doc": "echo 'N/A'",
    "minify-svg": "svgo --config=.svgo.config.js --quiet --recursive --folder resources/"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/mustache": "4.0.1",
    "@wikimedia/codex": "0.1.0-alpha.8",
    "@wikimedia/codex-icons": "0.1.0-alpha.8",
    "@wikimedia/codex-search": "0.1.0-alpha.8",
    "@wikimedia/mw-node-qunit": "6.4.2",
    "@wikimedia/types-wikimedia": "0.4.2",
    "@prettier/plugin-php": "0.22.3",
    "mustache": "3.0.1",
    "node-fetch": "2.6.7",
    "pa11y": "6.1.1",
    "postcss-less": "6.0.0",
    "prettier": "3.2.5",
    "svgo": "2.8.0"
  }
}
